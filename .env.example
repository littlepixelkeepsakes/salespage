# Stripe Checkout (use Stripe Test Mode keys sk_test_... and whsec_... during development)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional canonical base URL for Stripe Checkout redirect URLs (auto-detected from request host if empty)
APP_URL=

# Protected Staff Admin Passcode (overrides first-run setup when set)
ADMIN_PASSCODE=

# 1. Touch 'n Go eWallet QR Configuration
# Leave TNG_RECIPIENT_NAME or TNG_QR_IMAGE blank (or set TNG_ENABLED=false) to hide Touch 'n Go eWallet QR.
TNG_ENABLED=true
TNG_RECIPIENT_NAME=KRISTINA LEONG SIEW YIN
TNG_QR_IMAGE=/payments/duitnow-qr.png

# 2. Public Bank QR Pay Configuration
# Leave DUITNOW_RECIPIENT_NAME or DUITNOW_QR_IMAGE blank (or set DUITNOW_ENABLED=false) to hide Public Bank QR Pay.
DUITNOW_ENABLED=true
DUITNOW_RECIPIENT_NAME=KRISTINA LEONG SIEW YIN
DUITNOW_QR_IMAGE=/payments/duitnow-qrpbb.png
